# Copy to .env and fill in. Bun loads .env automatically — no dotenv needed.
# The six required ones are read at startup and throw if missing, so the
# server will not boot until they are all set. The last two are optional.

# Postgres. `docker compose up -d` (from the repo root) starts a matching
# instance; then run `bun run migrate`.
DATABASE_URL=

# Signs and verifies both access and refresh tokens (src/auth.ts).
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# S3, for photo snaps. Names mirror Bun's S3Client options (src/utils/s3.ts).
# Use an IAM user's key with infra/s3-policy.json, never the root account's.
# S3_REGION must be the bucket's own region, or every request fails.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. An S3-compatible server instead of AWS (CI's local stand-in), and
# the session token that comes with temporary credentials. Leave empty for AWS.
S3_ENDPOINT=
S3_SESSION_TOKEN=
