# Copy to .env and fill in. Bun loads .env automatically — no dotenv needed.
# Everything except the "Optional" blocks at the end is required: it's read at
# startup and throws if missing, so the server will not boot without it.

# Postgres. `docker compose up -d` (from the repo root) starts a matching
# instance; then run `bun run migrate`.
DATABASE_URL=

# RabbitMQ. The same `docker compose up -d` starts it with user snap/snap:
# amqp://snap:snap@localhost:5672 (web UI: http://localhost:15672).
RABBITMQ_URL=

# Signs and verifies both access and refresh tokens (src/auth.ts).
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# S3, for photo snaps. Names mirror Bun's S3Client options (src/utils/s3.ts).
# Use an IAM user's key with infra/s3-policy.json, never the root account's.
# S3_REGION must be the bucket's own region, or every request fails.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. An S3-compatible server instead of AWS (CI's local stand-in), and
# the session token that comes with temporary credentials. Leave empty for AWS.
S3_ENDPOINT=
S3_SESSION_TOKEN=

# Optional. Snap timing (src/config.ts); empty means the default:
#   SNAP_TTL_MS          how long a snap lives          86400000 (24 h)
#   SNAP_RETRY_DELAY_MS  wait between worker attempts   30000
#   SNAP_MAX_ATTEMPTS    attempts before dead-lettering 3
# The first two are also queue settings: once the queues exist, changing them
# needs those queues deleted first: stop the apps, delete snap.expiry.wait and
# snap.retry.wait in the RabbitMQ web UI, start again.
SNAP_TTL_MS=
SNAP_RETRY_DELAY_MS=
SNAP_MAX_ATTEMPTS=

# Optional. How many proxies in front of the api to believe about the client's
# IP (the rate limit counts per IP). Empty on the laptop; compose.stack.yml sets
# 1 for Traefik. Never set it where clients can reach the api directly.
TRUST_PROXY_HOPS=

# Optional. This process's name in RabbitMQ. Default: the hostname, which in
# Kubernetes is the pod name.
INSTANCE_ID=
