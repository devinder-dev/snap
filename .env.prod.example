# Full 40-character commit SHA of the published app and tools images.
SNAP_SHA=
# Public hostname served by the shared Traefik edge, without https://.
SNAP_HOST=
# Random hex database password (use openssl rand -hex 32).
SNAP_POSTGRES_PASSWORD=
# Random hex broker password (use openssl rand -hex 32).
SNAP_RABBITMQ_PASSWORD=
# Random JWT signing secret.
JWT_SECRET_KEY=
# Random registration code for the operator and production e2e only.
SNAP_REGISTRATION_CODE=
# Password for the three demo accounts. Required only when running seed-demo.
SNAP_DEMO_PASSWORD=
# Oracle's path-style namespace endpoint with no bucket or object suffix.
S3_ENDPOINT=
# Oracle region identifier.
S3_REGION=
# Private photos bucket name.
S3_BUCKET=
# Object Storage Customer Secret Key access-key ID.
S3_ACCESS_KEY_ID=
# Secret half of the Object Storage Customer Secret Key.
S3_SECRET_ACCESS_KEY=
